{
  "name": "mawatheeq",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "node scripts/build-pages.mjs",
    "start": "vite preview --config vite.pages.config.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "setup:ocr": "node scripts/copy-ocr-assets.mjs",
    "check": "tsc --noEmit",
    "test:pdf": "node scripts/verify-pdf-reader.mjs",
    "test:domain": "node --experimental-strip-types scripts/verify-domain.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test:shared": "node scripts/verify-shared-backend.mjs",
    "check:pages-config": "node scripts/check-pages-config.mjs",
    "test:local-auth": "node scripts/verify-local-auth.mjs",
    "test:browse": "node --experimental-strip-types scripts/verify-case-browse.mjs",
    "test:clients": "node --experimental-strip-types scripts/verify-client-model.mjs",
    "test:excel": "node scripts/verify-excel.mjs",
    "test:roll": "node scripts/verify-roll-import.mjs && node scripts/verify-roll-db.mjs",
    "test:office": "node --experimental-strip-types scripts/verify-office.mjs && node scripts/verify-office-db.mjs",
    "test:chat": "node scripts/verify-chat-db.mjs",
    "test:case-files": "node scripts/verify-case-files-db.mjs",
    "test:permissions": "node scripts/verify-permissions.mjs",
    "test:departments": "node scripts/verify-departments.mjs",
    "test:comments": "node scripts/verify-comments.mjs",
    "test:attendance": "node scripts/verify-attendance-db.mjs && node --experimental-strip-types scripts/verify-attendance.mjs && node scripts/verify-bridge.mjs",
    "test:tools": "node scripts/build-themes.mjs --check && node --experimental-strip-types scripts/verify-notifications.mjs && node --experimental-strip-types scripts/verify-print.mjs && node --experimental-strip-types scripts/verify-contact-links.mjs && node --experimental-strip-types scripts/verify-leave.mjs && node --experimental-strip-types scripts/verify-word-merge.mjs",
    "test:books": "node --experimental-strip-types scripts/verify-books.mjs && node --experimental-strip-types scripts/verify-bank-import.mjs && node scripts/verify-books-db.mjs && node scripts/verify-books-invoicing-db.mjs && node scripts/verify-books-bank-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pizzip": "^3.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
